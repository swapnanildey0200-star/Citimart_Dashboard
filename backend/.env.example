# Citimart Dashboard Environment Configuration
APP_NAME="Citimart Retail Analytics Dashboard"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# MongoDB Atlas or Local Connection String
# Free tier Atlas URI format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/citimart_retail?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="citimart_retail"

# Allowed CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Currency formatting (INR = Indian Rupee ₹, USD = $)
CURRENCY_CODE="INR"
NUMBER_FORMAT="lakh_crore" # "lakh_crore" or "standard_thousands"

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=50
SECRET_KEY="citimart-secret-analytics-key-change-in-production"
